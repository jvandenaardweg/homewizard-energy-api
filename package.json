{
  "displayName": "HomeWizard Energy API",
  "name": "homewizard-energy-api",
  "version": "2.0.0",
  "description": "Typesafe Node implementation of the HomeWizard Energy API",
  "license": "MIT",
  "author": {
    "name": "Jordy van den Aardweg",
    "url": "https://github.com/jvandenaardweg"
  },
  "homepage": "https://github.com/jvandenaardweg/homewizard-energy-api#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jvandenaardweg/homewizard-energy-api.git"
  },
  "bugs": {
    "url": "https://github.com/jvandenaardweg/homewizard-energy-api/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/jvandenaardweg"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/jvandenaardweg"
    }
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src && prettier --check .",
    "build": "rimraf ./dist && tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json",
    "prepublishOnly": "npm run test && npm run build",
    "pretest": "npm run lint && npm run type-check",
    "update": "npx npm-check-updates --interactive",
    "test": "TZ=Europe/Amsterdam vitest run --coverage",
    "test:watch": "TZ=Europe/Amsterdam vitest",
    "release": "dotenv npx release-it",
    "type-check": "tsc --noEmit",
    "prepare": "is-ci || husky",
    "lint-staged": "lint-staged",
    "watch": "nodemon ./src/examples/**",
    "watch:polling": "nodemon ./src/examples/polling-p1-meter-telegram.ts"
  },
  "keywords": [
    "homewizard",
    "homewizard-energy",
    "homewizard energy",
    "homewizard-energy-socket",
    "homewizard energy socket",
    "homewizard-api",
    "homewizard api",
    "homewizard-energy-api",
    "homewizard energy api"
  ],
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-istanbul": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "dotenv-cli": "^11.1.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "release-it": "^21.1.2",
    "rimraf": "^6.1.4",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@types/multicast-dns": "^7.2.4",
    "date-fns": "^4.4.0",
    "multicast-dns": "^7.2.5",
    "undici": "^8.12.4"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "release-it": {
      "proxy-agent": "^8.0.3"
    },
    "nodemon": {
      "minimatch": "^11.0.8"
    }
  }
}
