{
  "compilerOptions": {
    // Node 22, the lowest supported version, runs all of ES2024 but not all of ES2025
    "target": "ES2024",
    "lib": ["ES2024"],
    // ESM output ("type": "module"). Imports stay without an extension in the source, and tsc-alias adds ".js"
    // in dist (see "tsc-alias" below), so Node can load them.
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "incremental": false,
    "allowJs": false,
    "removeComments": false, // keep false, we want to have docs in dist
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      // The examples import the package by its name, as users do, and run from the source with tsx
      "homewizard-energy-api": ["./src/index.ts"],
      "homewizard-energy-api/v1": ["./src/v1/index.ts"],
      "homewizard-energy-api/telegram": ["./src/telegram/index.ts"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src/"],
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtension": ".js"
  }
}
